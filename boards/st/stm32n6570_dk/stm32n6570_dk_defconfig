# Enable UART driver
CONFIG_SERIAL=y

# Enable GPIO
CONFIG_GPIO=y

# Console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# No internal Flash
CONFIG_XIP=n

CONFIG_ETH_STM32_HAL_RGMII=y
CONFIG_ETH_STM32_AUTO_NEGOTIATION_ENABLE=n
CONFIG_ETH_STM32_SPEED_1000M=y